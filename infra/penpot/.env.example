# Local-only configuration. Copy to .env and replace the two placeholders.
# The .env file is intentionally ignored by Git.
COMPOSE_PROJECT_NAME=penpot-design-automation
PENPOT_VERSION=2.17
PENPOT_PUBLIC_URI=http://localhost:9001

# Generate unique values locally. Never commit these values.
PENPOT_SECRET_KEY=replace-with-a-random-64-byte-hex-secret
PENPOT_POSTGRES_PASSWORD=replace-with-a-strong-local-database-password

# These names point at the existing KatiauInvest data volumes during migration.
# Change only with a deliberate backup and restore plan.
PENPOT_POSTGRES_VOLUME=katiauinvest-penpot_penpot_postgres_data
PENPOT_ASSETS_VOLUME=katiauinvest-penpot_penpot_assets
