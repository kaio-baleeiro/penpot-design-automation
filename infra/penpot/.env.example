# Local-only configuration. Copy to .env and replace the two placeholders.
# The .env file is intentionally ignored by Git.
COMPOSE_PROJECT_NAME=penpot-design-automation
PENPOT_VERSION=2.17
PENPOT_PUBLIC_URI=http://localhost:9001

# Generate unique values locally. Never commit these values.
PENPOT_SECRET_KEY=replace-with-a-random-64-byte-hex-secret
PENPOT_POSTGRES_PASSWORD=replace-with-a-strong-local-database-password

# Fresh clones create neutral volumes automatically. A migrated instance keeps
# any existing names only in the local ignored .env.
PENPOT_POSTGRES_VOLUME=penpot-design-automation_postgres_data
PENPOT_ASSETS_VOLUME=penpot-design-automation_assets
PENPOT_CREATE_VOLUMES=true

# Optional: configure after enabling MCP in Penpot. Never commit these values.
# PENPOT_MCP_URL=
# PENPOT_MCP_TOKEN=
