.DS_Store
.idea/
.vscode/
*.swp

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
state/

# Runtime captures and private source material
runs/**/source-captures/*
runs/**/private/
runs/**/penpot-exports/
runs/**/cycles/**/*.png
runs/**/validation/**/*.png

# Private source artifacts. Sanitized artifacts must live under an explicit
# sanitized/ directory so that they can be reviewed and versioned safely.
**/dom.html
**/styles.json
**/raw/*
**/raw/**
**/private/
**/source-captures/
!**/source-captures/sanitized/
!**/source-captures/sanitized/**
!**/raw/sanitized/
!**/raw/sanitized/**
!**/sanitized/
!**/sanitized/**

# Dependencies and generated files
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
coverage/
dist/
build/
playwright-report/
test-results/
*.log

# Machine-local lessons are intentionally not published. Keep only each
# bucket README so a fresh clone explains where local notes belong.
skills/*/lessons-learned/local/*
!skills/*/lessons-learned/local/
!skills/*/lessons-learned/local/README.md

# Public benchmark evidence (source maps and visual comparisons) is explicitly
# allow-listed; private/raw captures remain covered by the rules above.
!runs/site-benchmarks/
!runs/site-benchmarks/**/
!runs/site-benchmarks/**/public/
!runs/site-benchmarks/**/public/**
!runs/site-benchmarks/**/analysis/
!runs/site-benchmarks/**/analysis/**
# Evaluator-generated cycle evidence is public/sanitized and is versioned so
# visitors can inspect the workflow without opening Penpot. Raw captures and
# validation/session material remain covered by the ignore rules above.
!runs/site-benchmarks/**/cycles/
!runs/site-benchmarks/**/cycles/**
